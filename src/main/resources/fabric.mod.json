{
  "schemaVersion": 1,
  "id": "neonlyrics",
  "version": "${version}",
  "name": "Lyrics Cord",
  "description": "Spotify lyrics in the sky, animated skies, glass HUD and a built-in FPS/performance mode. Client-only.",
  "authors": [
    "polishtraps85"
  ],
  "license": "MIT",
  "icon": "assets/neonlyrics/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.neonlyrics.NeonLyrics"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "accessWidener": "neonlyrics.accesswidener",
  "mixins": [
    "neonlyrics.mixins.json"
  ]
}
